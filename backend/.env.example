# Vedax - Backend Environment Template
# Copy this file to .env and fill in the values

# Express Server Port
PORT=3001
FRONTEND_URL=http://localhost:5173

# Appwrite Cloud Configuration
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_API_KEY=your_appwrite_server_admin_api_key

# Appwrite Database Settings
APPWRITE_DB_ID=ecogamify_db
APPWRITE_STORAGE_BUCKET=submissions_bucket

# AI Microservice Connection
AI_SERVICE_URL=http://localhost:8000

# Email Server (Nodemailer) Configuration 
# (Leave empty to simulate OTPs in terminal)
# If using Gmail, use smtp.gmail.com and port 465, with an App Password (not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-app-password
